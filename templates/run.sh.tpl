#!/usr/bin/env bash
# Generated by deliveryman skill — run with `./run.sh` to launch the delivered entry.
set -euo pipefail

ENTRY="{{ENTRY}}"
HERE="$( cd "$( dirname "${BASH_SOURCE[0]}" )" >/dev/null 2>&1 && pwd )"
TARGET="$HERE/$ENTRY"

if [[ ! -e "$TARGET" ]]; then
  echo "[deliveryman] 入口文件不存在: $TARGET" >&2
  echo "检查交付包是否完整，或联系作者。" >&2
  exit 1
fi

ext="${TARGET##*.}"

case "$ext" in
  html|htm)
    case "$(uname -s)" in
      Darwin) open "$TARGET" ;;
      Linux)  xdg-open "$TARGET" ;;
      *)      echo "请用浏览器打开 $TARGET" ;;
    esac
    ;;
  js)
    if ! command -v node >/dev/null 2>&1; then
      echo "[deliveryman] 需要 Node.js 才能运行 .js 入口。" >&2; exit 1
    fi
    node "$TARGET"
    ;;
  py)
    if command -v python3 >/dev/null 2>&1; then
      python3 "$TARGET"
    elif command -v python >/dev/null 2>&1; then
      python "$TARGET"
    else
      echo "[deliveryman] 需要 Python 才能运行 .py 入口。" >&2; exit 1
    fi
    ;;
  sh)
    bash "$TARGET"
    ;;
  *)
    # 可执行文件或未知扩展——尝试直接执行
    if [[ -x "$TARGET" ]]; then
      "$TARGET"
    else
      case "$(uname -s)" in
        Darwin) open "$TARGET" ;;
        Linux)  xdg-open "$TARGET" ;;
        *)      "$TARGET" ;;
      esac
    fi
    ;;
esac
