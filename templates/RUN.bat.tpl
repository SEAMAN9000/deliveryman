@echo off
chcp 65001 >nul
setlocal ENABLEDELAYEDEXPANSION

REM Generated by deliveryman skill — double-click to launch the delivered entry.
REM 入口由源项目的 deliver.config.yaml.user.entry 指定。

set "ENTRY={{ENTRY}}"
set "HERE=%~dp0"
set "TARGET=%HERE%%ENTRY%"

if not exist "%TARGET%" (
  echo [deliveryman] 入口文件不存在: %TARGET%
  echo 检查交付包是否完整，或联系作者。
  pause
  exit /b 1
)

REM 根据扩展名分派
for %%I in ("%TARGET%") do set "EXT=%%~xI"
if /i "%EXT%"==".exe" (
  start "" "%TARGET%"
) else if /i "%EXT%"==".bat" (
  call "%TARGET%"
) else if /i "%EXT%"==".cmd" (
  call "%TARGET%"
) else if /i "%EXT%"==".html" (
  start "" "%TARGET%"
) else if /i "%EXT%"==".htm" (
  start "" "%TARGET%"
) else if /i "%EXT%"==".js" (
  where node >nul 2>nul && (
    node "%TARGET%"
  ) || (
    echo [deliveryman] 需要 Node.js 才能运行 .js 入口。请安装后重试。
    pause
    exit /b 1
  )
) else if /i "%EXT%"==".py" (
  where python >nul 2>nul && (
    python "%TARGET%"
  ) || (
    echo [deliveryman] 需要 Python 才能运行 .py 入口。请安装后重试。
    pause
    exit /b 1
  )
) else (
  start "" "%TARGET%"
)

endlocal
